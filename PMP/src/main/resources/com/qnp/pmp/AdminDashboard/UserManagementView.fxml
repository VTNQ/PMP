<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500" prefWidth="800" style="-fx-background-color: #f4f6f8;"
            stylesheets="@user.css"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.qnp.pmp.controllers.UserAdminController">

    <!-- Khối chính -->
    <VBox spacing="15" AnchorPane.bottomAnchor="15" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="10">

        <!-- Tiêu đề -->
        <!-- Tiêu đề hiện đại -->
        <HBox alignment="CENTER" spacing="10" styleClass="title-container">
            <Label text="👥" styleClass="title-icon"/>
            <Label text="Quản Lý Người Dùng" styleClass="title-modern"/>
        </HBox>
        <Separator styleClass="title-line"/>


        <!-- Tìm kiếm -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🔍 Tìm kiếm:" />
            <TextField fx:id="searchField" prefWidth="250" promptText="Nhập tên người dùng..." styleClass="search-field" />
            <Button fx:id="btnSearch" text="🔍 Tìm" styleClass="search-button" />
        </HBox>

        <!-- Bảng người dùng -->
        <TableView fx:id="userTable" styleClass="modern-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="IndexCol" text="#" />
                <TableColumn fx:id="usernameCol" text="Tài khoản" />
                <TableColumn fx:id="fullNameCol" text="Họ tên" />
            </columns>
        </TableView>

        <!-- Nút hành động -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Button onAction="#addAction" prefWidth="120" styleClass="add-button" text="➕ Tạo mới" />
            <Button onAction="#refreshTable" prefWidth="120" styleClass="refresh-button" text="🔄 Làm mới" />
        </HBox>
    </VBox>
</AnchorPane>
