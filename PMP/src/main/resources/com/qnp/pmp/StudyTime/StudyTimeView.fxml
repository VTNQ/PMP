<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qnp.pmp.controllers.StudyTimeController"
      spacing="10"
      stylesheets="@StudyTimeView.css"
      style="-fx-background-color: #f9f9f9">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- ===== Header với nút đóng ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📚 Lịch học của cán bộ" styleClass="title-label"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="✖" onAction="#handleClose" styleClass="close-button"/>
    </HBox>

    <!-- ===== Bảng lịch học ===== -->
    <TableView fx:id="studyTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="roundCol" text="Lần học" prefWidth="100"/>
            <TableColumn fx:id="startDateCol" text="Từ ngày" prefWidth="150"/>
            <TableColumn fx:id="endDateCol" text="Đến ngày" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
