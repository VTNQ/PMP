<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.qnp.pmp.controllers.OfficerViewController"
            style="-fx-background-color:#f8f9fa;" stylesheets="@officer.css">

    <VBox spacing="12" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10"
          AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

        <!-- Thanh hành động -->
        <HBox spacing="10">
            <Label fx:id="totalLabel" text="Tổng: 0 cán bộ"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="➕ Thêm mới" styleClass=" add-btn" onAction="#add"/>
            <Button text="📥 Nhập nhiều" styleClass=" import-btn" onAction="#onImport"/>
            <Button text="🔄 Làm mới" styleClass=" refresh-btn" onAction="#refreshTable"/>
            <Button text="🗑 Xóa" styleClass=" delete-btn" onAction="#onDelete"/>
        </HBox>

        <!-- Tiêu đề -->
        <Label text="📊 Danh sách cán bộ đang hưởng phụ cấp"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <!-- Thanh tìm kiếm -->
        <HBox spacing="10">
            <Label text="🔍 Tìm kiếm:"/>
            <TextField fx:id="searchField" onKeyReleased="#onSearch"
                       prefWidth="300"
                       promptText="Nhập họ tên hoặc mã định danh..."/>
        </HBox>

        <!-- Bảng dữ liệu -->
        <TableView fx:id="officerTable" VBox.vgrow="ALWAYS" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="fullNameCol" text="👤 Họ tên" prefWidth="180"/>
                <TableColumn fx:id="identifierCodeCol" text="🆔 Mã định danh" prefWidth="140"/>
                <TableColumn fx:id="birthYearCol" text="📅 Năm sinh" prefWidth="100"/>
                <TableColumn fx:id="sinceCol" text="📆 Ngày bắt đầu" prefWidth="140"/>
                <TableColumn fx:id="unitCol" text="🏢 Đơn vị" prefWidth="140"/>
                <TableColumn fx:id="detailCol" text="⚙ Thao tác" prefWidth="100"/>
                <TableColumn fx:id="workCol" text="📋 Công tác" prefWidth="110"/>
            </columns>
        </TableView>


    </VBox>
</AnchorPane>
