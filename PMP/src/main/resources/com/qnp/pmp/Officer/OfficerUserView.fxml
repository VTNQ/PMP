<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.qnp.pmp.controllers.OfficerUserController"
            style="-fx-background-color:#f8f9fa;" stylesheets="@officer.css">

    <VBox spacing="12" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10"
          AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">


        <!-- Tiêu đề -->
        <Label text="📊 Danh sách cán bộ đang hưởng phụ cấp" styleClass="main-title"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <!-- Thanh tìm kiếm -->
        <HBox spacing="10">
            <Label text="🔍 Tìm kiếm:"/>
            <TextField fx:id="searchField" onKeyReleased="#onSearch"
                       prefWidth="300"
                       promptText="Nhập họ tên hoặc mã định danh..."/>
        </HBox>

        <!-- Bảng dữ liệu -->
        <TabPane fx:id="officerTabPane" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Trên 60 tháng">
                    <TableView fx:id="officerTableAbove60" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="fullNameColAbove" text="👤 Họ tên" prefWidth="180"/>
                            <TableColumn fx:id="identifierCodeColAbove" text="🆔 Số hiệu CAND" prefWidth="140"/>
                            <TableColumn fx:id="birthYearColAbove" text="📅 Năm sinh" prefWidth="100"/>
                            <TableColumn fx:id="allowanceColAbove" text="Tháng trợ cấp" prefWidth="140"/>
                            <TableColumn fx:id="unitColAbove" text="🏢 Đơn vị" prefWidth="140"/>
                            <TableColumn fx:id="detailColAbove" text="⚙ Thao tác" prefWidth="140"/>
                            <TableColumn fx:id="workColAbove" text="📋 Thời gian Thôi hưởng" prefWidth="110"/>
                        </columns>
                    </TableView>
                </Tab>
                <Tab text="Dưới hoặc bằng 60 tháng">
                    <TableView fx:id="officerTableBelow60" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="fullNameColBelow" text="👤 Họ tên" prefWidth="180"/>
                            <TableColumn fx:id="identifierCodeColBelow" text="🆔 Số hiệu CAND" prefWidth="140"/>
                            <TableColumn fx:id="birthYearColBelow" text="📅 Năm sinh" prefWidth="100"/>
                            <TableColumn fx:id="allowanceColBelow" text="Tháng trợ cấp" prefWidth="140"/>
                            <TableColumn fx:id="unitColBelow" text="🏢 Đơn vị" prefWidth="140"/>
                            <TableColumn fx:id="detailColBelow" text="⚙ Thao tác" prefWidth="140"/>
                            <TableColumn fx:id="workColBelow" text="📋 Công tác" prefWidth="110"/>
                        </columns>
                    </TableView>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>
</AnchorPane>
