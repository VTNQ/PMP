<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.qnp.pmp.controllers.EditOfficerController"
      spacing="15"
      prefHeight="500.0" prefWidth="600.0"
      styleClass="root-container"
      stylesheets="@AddOffice.css">

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <!-- ======= PHẦN TIÊU ĐỀ ======= -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="✏️ Cập nhật cán bộ" styleClass="form-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="✖" onAction="#onClose" styleClass="close-button"/>
    </HBox>

    <!-- ======= FORM NHẬP LIỆU ======= -->
    <GridPane hgap="15" vgap="12" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="70"/>
        </columnConstraints>

        <Label text="Họ tên:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Mã định danh:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="identifierField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Cấp bậc(ID):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="levelComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Đơn vị:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="unitField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Quê quán:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="homeTownField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Năm sinh:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="birthYearField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Ngày bắt đầu:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <DatePicker fx:id="sinceDatePicker" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Ngày kết thúc:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <DatePicker fx:id="utilDatePicker" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Ghi chú:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextArea fx:id="noteField" GridPane.rowIndex="8" GridPane.columnIndex="1" prefRowCount="3"/>
    </GridPane>

    <!-- ======= NÚT HÀNH ĐỘNG ======= -->
    <HBox spacing="20" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="💾 Lưu" onAction="#onSave" styleClass="save-button"/>
        <Button fx:id="updateAllowanceButton" text="🕒 Cập nhật thời gian hưởng"
                onAction="#onUpdateAllowanceTime" styleClass="secondary-button"/>
    </HBox>

</VBox>
